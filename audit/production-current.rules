rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * FUNCIONES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get("isPlatformSuperAdmin", false) == true
        ) ||
        (
          exists(
            /databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)
          ).data.get("role", "") in [
            "SUPERADMIN",
            "ADMIN_EMPRESA",
            "COORDINADOR"
          ]
        )
      );
    }

    // Internal advisers may operate ABP clients and activities, not accounting
    // or access management. Portal users with role USUARIO are excluded.
    function isAdviser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "ACTIVE") == "ACTIVE" &&
        exists(/databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)).data.get("status", "ACTIVE") == "ACTIVE" &&
        get(/databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)).data.get("role", "") == "ASESOR";
    }

    function ownsPolicy(policyId) {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/clientPolicies/$(policyId)
        ) &&
        get(
          /databases/$(database)/documents/clientPolicies/$(policyId)
        ).data.get("clientUid", "") == request.auth.uid;
    }

    /*
     * USUARIOS
     */

    match /users/{userId} {
      allow get: if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isAdmin() || isAdviser()
        );

      allow list: if isAdmin() || isAdviser();

      allow create: if isAdmin() || (isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get(
          "isPlatformSuperAdmin",
          false
        ) == false);

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&

        request.resource.data.get(
          "isPlatformSuperAdmin",
          false
        ) ==
        resource.data.get(
          "isPlatformSuperAdmin",
          false
        )
      );

      allow delete: if isAdmin();
    }

    /*
     * VOUCHERS EN RAÍZ
     */

    match /vouchers/{voucherId} {
      allow read, write: if isAdmin();

      match /edits/{editId} {
        allow read, create: if isAdmin();
      }

      match /lines/{lineId} {
        allow read, write: if isAdmin();
      }
    }

    /*
     * PLAN DE CUENTAS EN RAÍZ
     */

    match /chartOfAccounts/{accountId} {
      allow read, write: if isAdmin();
    }

    /*
     * CLIENTES EN RAÍZ
     */

    match /clients/{clientId} {
      allow read, delete: if isAdmin() ||
        (isAdviser() && resource.data.companyId == "abp");
      allow create: if isAdmin() ||
        (isAdviser() && request.resource.data.companyId == "abp");
      allow update: if isAdmin() || (isAdviser() &&
        resource.data.companyId == "abp" && request.resource.data.companyId == "abp");
    }

    match /activities/{activityId} {
      allow read, delete: if isAdmin() ||
        (isAdviser() && resource.data.companyId == "abp");
      allow create: if isAdmin() ||
        (isAdviser() && request.resource.data.companyId == "abp");
      allow update: if isAdmin() || (isAdviser() &&
        resource.data.companyId == "abp" && request.resource.data.companyId == "abp");
    }

    /*
     * PÓLIZAS DE CLIENTES
     */

    match /clientPolicies/{policyId} {

      /*
       * Consultar pólizas propias.
       */

      allow get, list: if isAdmin() || (
        isSignedIn() &&
        resource.data.get("clientUid", "") ==
          request.auth.uid
      );

      /*
       * La póliza principal solo puede ser administrada
       * por usuarios administradores.
       */

      allow create, update, delete: if isAdmin();

      /*
       * PERSONAS ASEGURADAS
       */

      match /insuredPeople/{personId} {

        allow read: if isAdmin() || ownsPolicy(policyId);

        /*
         * VINCULAR UN ASEGURADO
         */

        allow create: if isAdmin() || (
          ownsPolicy(policyId) &&

          request.resource.data.get("nombre", "") is string &&
          request.resource.data.get("nombre", "").size() > 0 &&

          request.resource.data.get("cedula", "") is string &&
          request.resource.data.get("cedula", "").size() > 0 &&

          request.resource.data.get(
            "fechaNacimiento",
            ""
          ) is string &&

          request.resource.data.get(
            "fechaVinculacion",
            ""
          ) is string &&

          request.resource.data.get(
            "valorMensual",
            0
          ) is number &&

          request.resource.data.get(
            "valorMensual",
            0
          ) >= 0 &&

          request.resource.data.get(
            "observaciones",
            ""
          ) is string &&

          request.resource.data.get(
            "estado",
            ""
          ) == "ACTIVO" &&

          request.resource.data.get(
            "fechaDesvinculacion",
            null
          ) == null &&

          request.resource.data.get(
            "tipoNovedad",
            ""
          ) == "INGRESO" &&

          request.resource.data.get(
            "valorNovedad",
            0
          ) is number &&

          request.resource.data.get(
            "valorNovedad",
            0
          ) >= 0
        );

        /*
         * EDITAR O DESVINCULAR UN ASEGURADO ACTIVO
         */

        allow update: if isAdmin() || (
          ownsPolicy(policyId) &&

          // Este bloque solo modifica personas activas.
          resource.data.get(
            "estado",
            "ACTIVO"
          ) != "DESVINCULADO" &&

          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "reg",
              "nombre",
              "cedula",
              "sexo",
              "fechaNacimiento",
              "edad",
              "extraprima",
              "valorMensual",
              "observaciones",
              "estado",
              "fechaDesvinculacion",
              "tipoNovedad",
              "valorNovedad",
              "diasNovedad",
              "tipoNovedadAnterior",
              "valorNovedadAnterior",
              "diasNovedadAnterior",
              "updatedAt"
            ]) &&

          // La fecha original de vinculación no cambia.
          request.resource.data.get(
            "fechaVinculacion",
            ""
          ) ==
          resource.data.get(
            "fechaVinculacion",
            ""
          ) &&

          // Solo existen estos dos estados.
          request.resource.data.get(
            "estado",
            "ACTIVO"
          ) in [
            "ACTIVO",
            "DESVINCULADO"
          ] &&

          request.resource.data.get(
            "valorMensual",
            0
          ) is number &&

          request.resource.data.get(
            "valorMensual",
            0
          ) >= 0 &&

          /*
           * Si se desvincula, debe incluir fecha,
           * tipo de novedad, días y valor proporcional.
           */

          (
            request.resource.data.get(
              "estado",
              "ACTIVO"
            ) == "ACTIVO" ||
            (
              request.resource.data.get(
                "estado",
                ""
              ) == "DESVINCULADO" &&

              request.resource.data.get(
                "fechaDesvinculacion",
                ""
              ) is string &&

              request.resource.data.get(
                "fechaDesvinculacion",
                ""
              ).size() > 0 &&

              request.resource.data.get(
                "tipoNovedad",
                ""
              ) == "RETIRO" &&

              request.resource.data.get(
                "valorNovedad",
                0
              ) is number &&

              request.resource.data.get(
                "valorNovedad",
                0
              ) >= 0 &&

              request.resource.data.get(
                "diasNovedad",
                0
              ) is number &&

              request.resource.data.get(
                "diasNovedad",
                0
              ) >= 0 &&

              request.resource.data.get(
                "diasNovedad",
                0
              ) <= 31
            )
          )
        );

        /*
         * DESHACER UN RETIRO
         *
         * Reactiva y restaura exclusivamente la novedad guardada antes
         * del retiro. No permite alterar identidad ni prima mensual.
         */

        allow update: if ownsPolicy(policyId) &&
          resource.data.get("estado", "") == "DESVINCULADO" &&
          request.resource.data.get("estado", "") == "ACTIVO" &&
          request.resource.data.get("fechaDesvinculacion", null) == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "estado", "fechaDesvinculacion", "updatedAt",
            "tipoNovedad", "valorNovedad", "diasNovedad"
          ]) && (
            // Compatibility with already-open clients using the old restore.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "estado", "fechaDesvinculacion", "updatedAt"
            ]) || (
              request.resource.data.get("tipoNovedad", null) == resource.data.get("tipoNovedadAnterior", null) &&
              request.resource.data.get("valorNovedad", null) == resource.data.get("valorNovedadAnterior", null) &&
              request.resource.data.get("diasNovedad", null) == resource.data.get("diasNovedadAnterior", null)
            )
          );

        /*
         * DESHACER UNA VINCULACIÓN
         *
         * El cliente solo puede borrar físicamente
         * registros creados como novedad de INGRESO.
         */

        allow delete: if isAdmin() || (
          ownsPolicy(policyId) &&

          resource.data.get(
            "estado",
            ""
          ) == "ACTIVO" &&

          resource.data.get(
            "tipoNovedad",
            ""
          ) == "INGRESO"
        );
      }
    }

    /*
     * NOTIFICACIONES DE CAMBIOS Y CONFIRMACIONES
     */

    match /clientChangeNotifications/{notifId} {

      allow create: if isSignedIn() &&

        request.resource.data.get(
          "clientUid",
          ""
        ) == request.auth.uid &&

        request.resource.data.get(
          "policyId",
          ""
        ) is string &&

        ownsPolicy(
          request.resource.data.get(
            "policyId",
            ""
          )
        ) &&

        request.resource.data.get(
          "action",
          ""
        ) in [
          "create",
          "update",
          "delete",
          "confirm_month"
        ] &&

        request.resource.data.get(
          "status",
          ""
        ) == "PENDING";

      allow get, list: if isAdmin() || (
        isSignedIn() &&
        resource.data.get(
          "clientUid",
          ""
        ) == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    /*
     * EMPRESAS
     */

    match /companies/{companyId} {
      allow read: if isSignedIn();

      /*
       * MEMBRESÍAS
       */

      match /memberships/{memberId} {
        allow get: if isSignedIn() &&
          (
            request.auth.uid == memberId ||
            isAdmin()
          );

        allow list: if isAdmin() || (companyId == "abp" && isAdviser());

        allow create, update, delete: if isAdmin();
      }

      /*
       * CLIENTES DE EMPRESA
       */

      match /clients/{clientId} {
        allow read, write: if isAdmin();
      }

      /*
       * ACTIVIDADES
       */

      match /activities/{activityId} {
        allow read, write: if isAdmin();
      }

      /*
       * PLAN DE CUENTAS
       */

      match /chartOfAccounts/{accountId} {
        allow read, write: if isAdmin();
      }

      /*
       * VOUCHERS
       */

      match /vouchers/{voucherId} {
        allow read, write: if isAdmin();

        match /lines/{lineId} {
          allow read, write: if isAdmin();
        }
      }

      /*
       * COMISIONES Y RECAUDOS
       */

      match /commissions/{recordId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
