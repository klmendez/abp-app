rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPlatformSuperAdmin == true) ||
        (exists(/databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/companies/abp/memberships/$(request.auth.uid)).data.role in ['SUPERADMIN', 'ADMIN_EMPRESA', 'COORDINADOR'])
      );
    }

    // Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Vouchers en raíz (con subcolección lines)
    match /vouchers/{voucherId} {
      allow read, write: if request.auth != null;
      
      match /lines/{lineId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Chart of Accounts en raíz
    match /chartOfAccounts/{accountId} {
      allow read, write: if request.auth != null;
    }
    
    // Clients en raíz
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // Políticas de clientes para vida grupo y otros seguros
    match /clientPolicies/{policyId} {
      allow read, write: if request.auth != null;

      match /insuredPeople/{personId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notificaciones de cambios hechos por clientes
    match /clientChangeNotifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Companies y subcolecciones
    match /companies/{companyId} {
      allow read: if request.auth != null;
      
      // Memberships
      match /memberships/{memberId} {
        allow read, write: if request.auth != null;
      }
      
      // Clients
      match /clients/{clientId} {
        allow read, write: if request.auth != null;
      }
      
      // Activities
      match /activities/{activityId} {
        allow read, write: if request.auth != null;
      }
      
      // Chart of Accounts
      match /chartOfAccounts/{accountId} {
        allow read, write: if request.auth != null;
      }
      
      // Vouchers
      match /vouchers/{voucherId} {
        allow read, write: if request.auth != null;
      }
      
      // Commissions - Colección para comisiones y recaudos
      match /commissions/{recordId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
